{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "1.1.0"
  },
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.png",
          "/apple-touch-icon.png",
          "/index.html",
          "/manifest.webmanifest",

          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/favicon.png",
          "/apple-touch-icon.png",
          "/*.(svg|woff|woff2|ttf|otf)"
        ]
      }
    }
  ]
}
